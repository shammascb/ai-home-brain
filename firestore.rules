rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidHomeState(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'selectedMode',
          'lightOn',
          'fanOn',
          'fanSpeed',
          'doorLocked',
          'doorOpen',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'selectedMode',
          'lightOn',
          'fanOn',
          'fanSpeed',
          'doorLocked',
          'doorOpen',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.selectedMode is string
        && data.selectedMode.size() <= 20
        && data.selectedMode in ['Home', 'Away', 'Sleep', 'Morning']
        && data.lightOn is bool
        && data.fanOn is bool
        && data.fanSpeed is int
        && data.fanSpeed >= 1
        && data.fanSpeed <= 5
        && data.doorLocked is bool
        && data.doorOpen is bool
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidActivity(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'icon', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'icon', 'createdAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.icon is string
        && data.icon.size() <= 20
        && data.icon in ['light', 'fan', 'door', 'mode', 'voice']
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidAutomationRoutine(data, userId, routineId) {
      return data.keys().hasAll([
          'ownerId',
          'routineId',
          'lightAction',
          'fanAction',
          'fanSpeed',
          'doorAction',
          'requireSafetyConfirmation',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'routineId',
          'lightAction',
          'fanAction',
          'fanSpeed',
          'doorAction',
          'requireSafetyConfirmation',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.routineId is string
        && data.routineId == routineId
        && data.routineId.size() <= 20
        && data.routineId in ['sleep', 'morning', 'away']
        && data.lightAction is string
        && data.lightAction.size() <= 20
        && data.lightAction in ['turn_on', 'turn_off', 'unchanged']
        && data.fanAction is string
        && data.fanAction.size() <= 20
        && data.fanAction in ['turn_on', 'turn_off', 'unchanged']
        && data.fanSpeed is int
        && data.fanSpeed >= 1
        && data.fanSpeed <= 5
        && data.doorAction is string
        && data.doorAction.size() <= 32
        && data.doorAction in ['lock_with_safety_check', 'keep_locked', 'unchanged']
        && data.requireSafetyConfirmation is bool
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;

      match /homeState/{stateId} {
        allow get: if isValidId(userId)
          && isValidId(stateId)
          && stateId == 'default'
          && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(stateId)
          && stateId == 'default'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidHomeState(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(stateId)
          && stateId == 'default'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidHomeState(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'selectedMode',
            'lightOn',
            'fanOn',
            'fanSpeed',
            'doorLocked',
            'doorOpen',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      match /activities/{activityId} {
        allow get: if isValidId(userId)
          && isValidId(activityId)
          && isOwner(userId);
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(activityId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidActivity(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId)
          && isValidId(activityId)
          && isVerifiedUser()
          && isOwner(userId);
      }

      match /routines/{routineId} {
        allow get: if isValidId(userId)
          && isValidId(routineId)
          && routineId in ['sleep', 'morning', 'away']
          && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(routineId)
          && routineId in ['sleep', 'morning', 'away']
          && isVerifiedUser()
          && isOwner(userId)
          && isValidAutomationRoutine(incoming(), userId, routineId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(routineId)
          && routineId in ['sleep', 'morning', 'away']
          && isVerifiedUser()
          && isOwner(userId)
          && isValidAutomationRoutine(incoming(), userId, routineId)
          && incoming().ownerId == existing().ownerId
          && incoming().routineId == existing().routineId
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'lightAction',
            'fanAction',
            'fanSpeed',
            'doorAction',
            'requireSafetyConfirmation',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId)
          && isValidId(routineId)
          && routineId in ['sleep', 'morning', 'away']
          && isVerifiedUser()
          && isOwner(userId);
      }
    }
  }
}
